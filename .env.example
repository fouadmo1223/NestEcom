# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Database ───────────────────────────────────────────────────────────────
# Either provide DATABASE_URL (managed Postgres, e.g. Neon) …
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# … or the discrete fields for a local database:
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=marketplace

# Schema management.
# The baseline schema now lives in src/db/migrations (P1VendorDomain … P8Indexes).
# Keep DB_SYNC=false everywhere and evolve the schema through migrations only.
# Set DB_SYNC=true transiently on a throwaway local DB if you need to prototype
# entity changes, then generate a migration and switch it back off.
DB_SYNC=false
# When true, pending migrations run automatically on app boot. Leave false and
# run `npm run migration:run` from CI/a one-off task for predictable deploys.
DB_MIGRATIONS_RUN=false

# ─── Auth / JWT ─────────────────────────────────────────────────────────────
# Generate strong random values, e.g. `openssl rand -base64 48`.
JWT_SECRET=change-me-access-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS / frontends ───────────────────────────────────────────────────────
# Comma-separated exact origins allowed to send credentialed requests.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Where the Google OAuth callback redirects with the one-time code.
WEB_URL=http://localhost:3000
OAUTH_SUCCESS_REDIRECT=http://localhost:3000/auth/callback

# ─── Google OAuth ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# ─── Cloudinary (image uploads) ────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── Mail (SMTP) ───────────────────────────────────────────────────────────
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=no-reply@example.com
MAIL_PASS=your-smtp-password
MAIL_FROM="Marketplace <no-reply@example.com>"

# ─── Platform defaults ─────────────────────────────────────────────────────
# Seed values for the platform_settings singleton on first boot. After that the
# row is authoritative and is edited via PATCH /admin/settings.
PLATFORM_DEFAULT_COMMISSION_RATE=0.1
PLATFORM_CURRENCY=EGP
PLATFORM_MIN_PAYOUT=0
PLATFORM_LOW_STOCK_THRESHOLD=5
